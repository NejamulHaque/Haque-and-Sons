{
  "name": "haque-and-sons",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "grep": "grep -r \"type\" . --include=\"*.ts\" --include=\"*.tsx\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,yml}": [
      "pnpm exec prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
